// ============================================================
// Prisma Schema for ChainLance
// ============================================================
// Database: PostgreSQL
// ORM: Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  client
  freelancer
  both
}

enum JobStatus {
  open
  in_progress
  completed
  cancelled
}

enum ProposalStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum ProjectStatus {
  active
  completed
  disputed
  cancelled
}

enum MilestoneStatus {
  pending
  funded
  submitted
  approved
  paid
  disputed
  refunded
}

enum DisputeStatus {
  open
  under_review
  resolved_client
  resolved_freelancer
  resolved_split
}

enum EscrowEventType {
  created
  funded
  released
  refunded
}

// ============================================================
// MODELS
// ============================================================

model User {
  id             String   @id @default(uuid())
  walletAddress  String   @unique @map("wallet_address") @db.VarChar(42)
  email          String?  @unique @db.VarChar(255)
  displayName    String   @map("display_name") @db.VarChar(100)
  role           UserRole
  bio            String?  @db.Text
  skills         Json     @default("[]") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  jobsPosted        Job[]                @relation("ClientJobs")
  proposals         Proposal[]
  projectsAsClient  Project[]            @relation("ClientProjects")
  projectsAsFreelancer Project[]         @relation("FreelancerProjects")
  disputesRaised    Dispute[]            @relation("DisputeRaiser")
  disputesResolved  Dispute[]            @relation("DisputeResolver")
  messagesSent      Message[]

  @@index([walletAddress])
  @@index([role])
  @@map("users")
}

model Job {
  id              String     @id @default(uuid())
  clientId        String     @map("client_id")
  title           String     @db.VarChar(200)
  description     String     @db.Text
  budget          Decimal    @db.Decimal(18, 6)
  status          JobStatus  @default(open)
  requiredSkills  Json       @default("[]") @map("required_skills") @db.JsonB
  deadline        DateTime?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  client          User       @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Restrict)
  proposals       Proposal[]
  projects        Project[]

  @@index([clientId, status])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("jobs")
}

model Proposal {
  id                String          @id @default(uuid())
  jobId             String          @map("job_id")
  freelancerId      String          @map("freelancer_id")
  coverLetter       String          @map("cover_letter") @db.Text
  proposedAmount    Decimal         @map("proposed_amount") @db.Decimal(18, 6)
  estimatedDuration Int?            @map("estimated_duration")
  status            ProposalStatus  @default(pending)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Relations
  job               Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  freelancer        User            @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  project           Project?

  @@unique([jobId, freelancerId])
  @@index([jobId, status])
  @@index([freelancerId, status])
  @@map("proposals")
}

model Project {
  id            String         @id @default(uuid())
  jobId         String         @map("job_id")
  proposalId    String         @unique @map("proposal_id")
  clientId      String         @map("client_id")
  freelancerId  String         @map("freelancer_id")
  totalAmount   Decimal        @map("total_amount") @db.Decimal(18, 6)
  status        ProjectStatus  @default(active)
  startedAt     DateTime       @default(now()) @map("started_at")
  completedAt   DateTime?      @map("completed_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  proposal      Proposal       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client        User           @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer    User           @relation("FreelancerProjects", fields: [freelancerId], references: [id], onDelete: Restrict)
  milestones    Milestone[]
  messages      Message[]

  @@index([clientId, status])
  @@index([freelancerId, status])
  @@index([startedAt(sort: Desc)])
  @@map("projects")
}

model Milestone {
  id                     String            @id @default(uuid())
  projectId              String            @map("project_id")
  title                  String            @db.VarChar(200)
  description            String            @db.Text
  amount                 Decimal           @db.Decimal(18, 6)
  escrowContractAddress  String?           @unique @map("escrow_contract_address") @db.VarChar(42)
  status                 MilestoneStatus   @default(pending)
  dueDate                DateTime?         @map("due_date")
  submittedAt            DateTime?         @map("submitted_at")
  approvedAt             DateTime?         @map("approved_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  // Relations
  project                Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  escrowTransactions     EscrowTransaction[]
  disputes               Dispute[]

  @@index([projectId, status])
  @@index([escrowContractAddress])
  @@map("milestones")
}

model EscrowTransaction {
  id              String           @id @default(uuid())
  milestoneId     String           @map("milestone_id")
  transactionHash String           @unique @map("transaction_hash") @db.VarChar(66)
  eventType       EscrowEventType  @map("event_type")
  fromAddress     String           @map("from_address") @db.VarChar(42)
  amount          Decimal          @db.Decimal(18, 6)
  blockNumber     BigInt           @map("block_number")
  timestamp       DateTime
  createdAt       DateTime         @default(now()) @map("created_at")

  // Relations
  milestone       Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  @@index([milestoneId, timestamp(sort: Desc)])
  @@index([blockNumber])
  @@map("escrow_transactions")
}

model Dispute {
  id              String         @id @default(uuid())
  milestoneId     String         @map("milestone_id")
  raisedBy        String         @map("raised_by")
  reason          String         @db.Text
  status          DisputeStatus  @default(open)
  resolutionNotes String?        @map("resolution_notes") @db.Text
  resolvedBy      String?        @map("resolved_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  resolvedAt      DateTime?      @map("resolved_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  milestone       Milestone      @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  raiser          User           @relation("DisputeRaiser", fields: [raisedBy], references: [id], onDelete: Restrict)
  resolver        User?          @relation("DisputeResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([status, createdAt(sort: Desc)])
  @@map("disputes")
}

model Message {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  senderId   String    @map("sender_id")
  content    String    @db.Text
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sender     User      @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}
